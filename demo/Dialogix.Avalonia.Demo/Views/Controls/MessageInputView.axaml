<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Dialogix.Avalonia.Controls"
             x:Class="Dialogix.Avalonia.Demo.Views.Controls.MessageInputView">

    <UserControl.Resources>
        <DrawingImage x:Key="DemoPaperPlaneImage">
            <GeometryDrawing Geometry="M3 9 L18 3 L14 17 L10 11 Z M10 11 L18 3">
                <GeometryDrawing.Pen>
                    <Pen Brush="{DynamicResource DialogixPrimaryForegroundBrush}"
                         Thickness="2"
                         LineCap="Round"
                         LineJoin="Round" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource DemoChatBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 48 -20 #1F000000" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBlock.result">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Nudge the paper plane inside the send circle. -->
        <Style Selector="controls|MessageInput.icon Path">
            <Setter Property="RenderTransform" Value="translate(-0.75px,0.75px)" />
        </Style>

        <Style Selector="controls|MessageInput.image Image">
            <Setter Property="RenderTransform" Value="translate(-0.25px,0.25px)" />
        </Style>

        <!-- Restyling a control by selector, without touching the library theme. -->
        <Style Selector="controls|MessageInput.mono">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF111111" />
            <Setter Property="BorderBrush" Value="#FF111111" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel x:Name="PageContent"
                    MaxWidth="1140"
                    Margin="24"
                    Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle"
                           Text="MessageInput"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Enter sends, Shift+Enter adds a line — and it stays one size."
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <WrapPanel x:Name="Cards"
                       Orientation="Horizontal">

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Default" />
                            <TextBlock Classes="cardHint" Text="Library brushes, light and dark." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputDefault" />
                        <TextBlock x:Name="SentDefault"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Violet" />
                            <TextBlock Classes="cardHint" Text="Scoped brush overrides in Resources." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputViolet">
                            <controls:MessageInput.Resources>
                                <SolidColorBrush x:Key="DialogixSurfaceBrush" Color="#FF2A1B4D" />
                                <SolidColorBrush x:Key="DialogixSurfaceForegroundBrush" Color="#FFEDE9FE" />
                                <SolidColorBrush x:Key="DialogixBorderBrush" Color="#FF3B2A66" />
                                <SolidColorBrush x:Key="DialogixInputBackgroundBrush" Color="#FF241540" />
                                <SolidColorBrush x:Key="DialogixMutedForegroundBrush" Color="#FFB4A6E0" />
                                <SolidColorBrush x:Key="DialogixPrimaryBrush" Color="#FF8B5CF6" />
                                <SolidColorBrush x:Key="DialogixPrimaryHoverBrush" Color="#FF9F7BFA" />
                                <SolidColorBrush x:Key="DialogixPrimaryPressedBrush" Color="#FF7C4BEF" />
                            </controls:MessageInput.Resources>
                        </controls:MessageInput>
                        <TextBlock x:Name="SentViolet"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Mono" />
                            <TextBlock Classes="cardHint" Text="Restyled by selectors, square and sharp." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputMono"
                                               Classes="mono">
                            <controls:MessageInput.Resources>
                                <SolidColorBrush x:Key="DialogixInputBackgroundBrush" Color="#FFF0F0F0" />
                                <SolidColorBrush x:Key="DialogixMutedForegroundBrush" Color="#FF666666" />
                                <SolidColorBrush x:Key="DialogixPrimaryBrush" Color="#FF111111" />
                                <SolidColorBrush x:Key="DialogixPrimaryHoverBrush" Color="#FF333333" />
                                <SolidColorBrush x:Key="DialogixPrimaryPressedBrush" Color="#FF000000" />
                            </controls:MessageInput.Resources>
                        </controls:MessageInput>
                        <TextBlock x:Name="SentMono"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Multi-line" />
                            <TextBlock Classes="cardHint" Text="MaxLines caps the height, then it scrolls." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputMulti"
                                               MaxLines="3"
                                               Text="First line&#10;Second line&#10;Third line" />
                        <TextBlock x:Name="SentMulti"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Limit" />
                            <TextBlock Classes="cardHint"
                                       Text="MaxLength shows a counter and blocks sending." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputLimit"
                                               MaxLength="60"
                                               Watermark="Up to 60 characters" />
                        <TextBlock x:Name="SentLimit"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Icon" />
                            <TextBlock Classes="cardHint"
                                       Text="SendIcon swapped for the paper plane." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputIcon"
                                               Classes="icon"
                                               SendIcon="{DynamicResource DialogixPaperPlaneIconGeometry}" />
                        <TextBlock x:Name="SentIcon"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Image icon" />
                            <TextBlock Classes="cardHint"
                                       Text="SendIcon also accepts any IImage." />
                        </StackPanel>
                        <controls:MessageInput x:Name="InputImageIcon"
                                               Classes="image"
                                               SendIcon="{DynamicResource DemoPaperPlaneImage}" />
                        <TextBlock x:Name="SentImageIcon"
                                   Classes="result"
                                   Text="Nothing sent yet." />
                    </StackPanel>
                </Border>

            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
