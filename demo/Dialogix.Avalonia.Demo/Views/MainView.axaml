<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="Dialogix.Avalonia.Demo.Views.MainView">

    <fa:FANavigationView x:Name="Nav"
                         PaneDisplayMode="Left"
                         IsPaneOpen="True"
                         OpenPaneLength="220"
                         PaneTitle="Dialogix"
                         IsSettingsVisible="False"
                         IsBackButtonVisible="False"
                         IsPaneToggleButtonVisible="False"
                         AlwaysShowHeader="False"
                         Background="{DynamicResource DemoPageBackgroundBrush}"
                         FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
                         SelectionChanged="OnNavigationSelectionChanged">

        <fa:FANavigationView.MenuItems>
            <fa:FANavigationViewItem x:Name="BubbleItem" Content="Message Bubble" Tag="bubble">
                <fa:FANavigationViewItem.IconSource>
                    <fa:FASymbolIconSource Symbol="Comment" />
                </fa:FANavigationViewItem.IconSource>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem x:Name="InputItem" Content="Message Input" Tag="input">
                <fa:FANavigationViewItem.IconSource>
                    <fa:FASymbolIconSource Symbol="Edit" />
                </fa:FANavigationViewItem.IconSource>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem x:Name="ChatItem" Content="Chat View" Tag="chat">
                <fa:FANavigationViewItem.IconSource>
                    <fa:FASymbolIconSource Symbol="Message" />
                </fa:FANavigationViewItem.IconSource>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem x:Name="MessengerItem" Content="Messenger" Tag="messenger">
                <fa:FANavigationViewItem.IconSource>
                    <fa:FASymbolIconSource Symbol="Message" />
                </fa:FANavigationViewItem.IconSource>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem x:Name="ConversationsItem" Content="Conversations" Tag="conversations">
                <fa:FANavigationViewItem.IconSource>
                    <fa:FASymbolIconSource Symbol="Contact" />
                </fa:FANavigationViewItem.IconSource>
            </fa:FANavigationViewItem>
            <fa:FANavigationViewItem x:Name="ProfileNavItem" Content="Profile" Tag="profile">
                <fa:FANavigationViewItem.IconSource>
                    <fa:FASymbolIconSource Symbol="Contact" />
                </fa:FANavigationViewItem.IconSource>
            </fa:FANavigationViewItem>
        </fa:FANavigationView.MenuItems>

        <fa:FANavigationView.PaneFooter>
            <ToggleSwitch x:Name="ThemeSwitch"
                          Margin="12,8,12,16"
                          IsChecked="True"
                          Content="Dark theme"
                          IsCheckedChanged="OnThemeSwitchChanged" />
        </fa:FANavigationView.PaneFooter>

        <fa:FANavigationView.Content>
            <ContentControl x:Name="PageHost" />
        </fa:FANavigationView.Content>

    </fa:FANavigationView>
</UserControl>
