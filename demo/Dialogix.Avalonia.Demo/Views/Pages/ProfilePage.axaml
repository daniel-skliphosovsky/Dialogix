<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Dialogix.Avalonia.Controls"
             xmlns:local="using:Dialogix.Avalonia.Demo.Views.Pages"
             x:Class="Dialogix.Avalonia.Demo.Views.Pages.ProfilePage">

    <UserControl.Resources>

        <Geometry x:Key="SettingsIcon">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</Geometry>
        <Geometry x:Key="NotificationsIcon">M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z</Geometry>
        <Geometry x:Key="PrivacyIcon">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</Geometry>

        <DrawingImage x:Key="SampleAvatar">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,100" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#FF8B5CF6" Offset="0" />
                                <GradientStop Color="#FF6366F1" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF8FAFC">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="50,36" RadiusX="14" RadiusY="14" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF8FAFC">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="50,78" RadiusX="27" RadiusY="19" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DataTemplate x:Key="ProfileItemTemplate" x:DataType="local:ProfileItem">
            <Border Classes="row">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Path Width="18"
                          Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Data="{Binding Icon}"
                          Fill="{DynamicResource DialogixMutedForegroundBrush}" />
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VioletRowTemplate" x:DataType="local:ProfileItem">
            <Border Classes="row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Width="18"
                          Height="18"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Data="{Binding Icon}"
                          Fill="{DynamicResource DialogixMutedForegroundBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="{Binding Text}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="›"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Opacity="0.4" />
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource DemoChatBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 48 -20 #1F000000" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="Border.row">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogixChatBackgroundBrush}" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- Restyling the editor by selector, without touching the library theme. -->
        <Style Selector="controls|ProfileEditorView.mono">
            <Setter Property="Background" Value="#FF111111" />
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="BorderBrush" Value="#FF3D3D3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
        </Style>

        <Style Selector="controls|ProfileEditorView.mono /template/ Border#PART_Root">
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        </Style>

        <Style Selector="controls|ProfileEditorView.mono /template/ Button">
            <Setter Property="CornerRadius" Value="4" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel x:Name="PageContent"
                    MaxWidth="1140"
                    Margin="24"
                    Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Profile"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Avatar, custom rows, scoped palettes and an editor the app fills in."
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <WrapPanel x:Name="Cards"
                       Orientation="Horizontal"
                       ItemWidth="326">

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Default" />
                            <TextBlock Classes="cardHint" Text="Library brushes, clickable rows and the edit flow." />
                        </StackPanel>

                        <Panel>
                            <StackPanel Spacing="10">
                                <controls:ProfileView x:Name="Profile"
                                                      Width="300"
                                                      DisplayName="Guest" />
                                <TextBlock x:Name="ItemStatus"
                                           Classes="cardHint"
                                           HorizontalAlignment="Center"
                                           Text="Nothing opened yet." />
                            </StackPanel>

                            <controls:ProfileEditorView x:Name="Editor"
                                                        IsVisible="False"
                                                        Title="Edit profile">
                                <controls:ProfileEditorView.Fields>
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="Display name" />
                                            <TextBox x:Name="NameBox"
                                             Theme="{DynamicResource DialogixTextBoxTheme}"
                                             Text="Guest" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="Bio" />
                                            <TextBox x:Name="BioBox"
                                             Theme="{DynamicResource DialogixTextBoxTheme}"
                                             Text="Avalonia UI enthusiast." />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:ProfileEditorView.Fields>
                            </controls:ProfileEditorView>
                        </Panel>
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="DialogixSurfaceBrush" Color="#FF2A1B4D" />
                            <SolidColorBrush x:Key="DialogixSurfaceForegroundBrush" Color="#FFEDE9FE" />
                            <SolidColorBrush x:Key="DialogixBorderBrush" Color="#FF3B2A66" />
                            <SolidColorBrush x:Key="DialogixChatBackgroundBrush" Color="#FF1B1035" />
                            <SolidColorBrush x:Key="DialogixMutedForegroundBrush" Color="#FFB4A6E0" />
                            <SolidColorBrush x:Key="DialogixPrimaryBrush" Color="#FF8B5CF6" />
                            <SolidColorBrush x:Key="DialogixPrimaryHoverBrush" Color="#FF9F7BFA" />
                            <SolidColorBrush x:Key="DialogixPrimaryPressedBrush" Color="#FF7C4BEF" />
                            <SolidColorBrush x:Key="DialogixPrimaryForegroundBrush" Color="#FFFFFFFF" />
                        </StackPanel.Resources>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Violet" />
                            <TextBlock Classes="cardHint" Text="Scoped brushes, custom rows, no edit button." />
                        </StackPanel>

                        <controls:ProfileView x:Name="VioletProfile"
                                              Width="300"
                                              DisplayName="Guest"
                                              IsEditVisible="False"
                                              Avatar="{StaticResource SampleAvatar}" />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Margin="0,0,10,10">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Mono" />
                            <TextBlock Classes="cardHint" Text="Editor restyled by selectors, custom texts and avatar." />
                        </StackPanel>

                        <controls:ProfileEditorView Classes="mono"
                                                    Title="Your profile"
                                                    SaveText="Apply"
                                                    CancelText="Back"
                                                    Avatar="{StaticResource SampleAvatar}">
                            <controls:ProfileEditorView.Fields>
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="Display name" />
                                        <TextBox Theme="{DynamicResource DialogixTextBoxTheme}"
                                             Text="Guest" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="Bio" />
                                        <TextBox Theme="{DynamicResource DialogixTextBoxTheme}"
                                             Text="Square corners, monospace." />
                                    </StackPanel>
                                </StackPanel>
                            </controls:ProfileEditorView.Fields>
                        </controls:ProfileEditorView>
                    </StackPanel>
                </Border>

            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
