<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Dialogix.Avalonia.Controls"
             xmlns:local="using:Dialogix.Avalonia.Demo.Views.Pages"
             x:Class="Dialogix.Avalonia.Demo.Views.Pages.MessengerPage">

    <UserControl.Styles>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource DemoChatBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 48 -20 #1F000000" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel MaxWidth="1140"
                    Margin="24"
                    Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Messenger"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="The conversation list, active chat and composer in one control."
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="cardTitle" Text="Inbox" />
                        <TextBlock Classes="cardHint" Text="Pick a conversation and send a message." />
                    </StackPanel>

                    <controls:MessengerView x:Name="Messenger"
                                            Height="620"
                                            ListWidth="300">
                        <controls:MessengerView.ConversationTemplate>
                            <DataTemplate x:DataType="local:MessengerConversation">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="19"
                                            Background="{DynamicResource DialogixAccentBrush}">
                                        <TextBlock Text="{Binding Initials}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DialogixAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="12"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Time}"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   HorizontalAlignment="Right" />
                                        <Border IsVisible="{Binding IsUnread}"
                                                MinWidth="18"
                                                Height="18"
                                                Padding="4,0"
                                                CornerRadius="9"
                                                Background="{DynamicResource DialogixPrimaryBrush}"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Unread}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource DialogixPrimaryForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:MessengerView.ConversationTemplate>

                        <controls:MessengerView.MessageTemplate>
                            <DataTemplate x:DataType="local:MessengerMessage">
                                <controls:MessageBubble Text="{Binding Text}"
                                                        Author="{Binding Author}"
                                                        Timestamp="{Binding Time}"
                                                        IsOutgoing="{Binding IsOutgoing}" />
                            </DataTemplate>
                        </controls:MessengerView.MessageTemplate>
                    </controls:MessengerView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
