<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Dialogix.Avalonia.Controls"
             xmlns:local="using:Dialogix.Avalonia.Demo.Views.Pages"
             x:Class="Dialogix.Avalonia.Demo.Views.Pages.MessengerPage">

    <UserControl.Resources>

        <DataTemplate x:Key="ConversationTemplate" x:DataType="local:MessengerConversation">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="{DynamicResource DialogixAccentBrush}">
                    <TextBlock Text="{Binding Initials}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DialogixAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransform="translate(0,1px)" />
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Preview}"
                               FontSize="12"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Time}"
                               FontSize="11"
                               Opacity="0.5"
                               HorizontalAlignment="Right" />
                    <Border IsVisible="{Binding IsUnread}"
                            MinWidth="18"
                            Height="18"
                            Padding="4,0"
                            CornerRadius="9"
                            Background="{DynamicResource DialogixPrimaryBrush}"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Unread}"
                                   FontSize="10"
                                   Foreground="{DynamicResource DialogixPrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate" x:DataType="local:MessengerMessage">
            <controls:MessageBubble Text="{Binding Text}"
                                    Author="{Binding Author}"
                                    Timestamp="{Binding Time}"
                                    IsOutgoing="{Binding IsOutgoing}" />
        </DataTemplate>

        <DataTemplate x:Key="EmptyMessagesTemplate" x:DataType="local:MessengerEmptyState">
            <StackPanel Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Hint}"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource DemoChatBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BoxShadow" Value="0 6 48 -20 #1F000000" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.cardHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel MaxWidth="1140"
                    Margin="24"
                    Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Messenger"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="The conversation list, active chat and composer in one control."
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="cardTitle" Text="Inbox" />
                        <TextBlock Classes="cardHint" Text="Pick a conversation and send a message." />
                    </StackPanel>

                    <controls:MessengerView x:Name="Messenger"
                                            Height="620"
                                            ListWidth="300"
                                            ConversationTemplate="{StaticResource ConversationTemplate}"
                                            MessageTemplate="{StaticResource MessageTemplate}"
                                            MessagesEmptyContentTemplate="{StaticResource EmptyMessagesTemplate}" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="Empty chat" />
                            <TextBlock Classes="cardHint" Text="A selected conversation without messages." />
                        </StackPanel>

                        <controls:MessengerView x:Name="EmptyChat"
                                                Height="440"
                                                ListWidth="240"
                                                ConversationTemplate="{StaticResource ConversationTemplate}"
                                                MessageTemplate="{StaticResource MessageTemplate}"
                                                MessagesEmptyContentTemplate="{StaticResource EmptyMessagesTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardTitle" Text="No selection" />
                            <TextBlock Classes="cardHint" Text="The placeholder fills the chat pane." />
                        </StackPanel>

                        <controls:MessengerView x:Name="NoSelection"
                                                Height="440"
                                                ListWidth="240"
                                                PlaceholderText="Pick a conversation to start"
                                                ConversationTemplate="{StaticResource ConversationTemplate}"
                                                MessageTemplate="{StaticResource MessageTemplate}"
                                                MessagesEmptyContentTemplate="{StaticResource EmptyMessagesTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card matrixCard"
                    Background="#FF050807"
                    BorderBrush="#FF1F6F43"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 0 30 -12 #6600FF66">
                <StackPanel Spacing="10">
                    <StackPanel.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceInclude Source="avares://Dialogix.Avalonia.Demo/Themes/MatrixPalette.axaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </StackPanel.Resources>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="cardTitle" Text="Matrix" />
                        <TextBlock Classes="cardHint" Text="Terminal green across list, chat and composer." />
                    </StackPanel>

                    <controls:MessengerView x:Name="MatrixMessenger"
                                            Classes="matrix"
                                            Height="620"
                                            ListWidth="300"
                                            ConversationTemplate="{StaticResource ConversationTemplate}"
                                            MessageTemplate="{StaticResource MessageTemplate}"
                                            MessagesEmptyContentTemplate="{StaticResource EmptyMessagesTemplate}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
