<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="using:Dialogix.Avalonia.Demo.Infrastructure"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Dialogix.Avalonia.Demo.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="DemoPageBackgroundBrush" Color="#FFF4F5F7" />
                    <SolidColorBrush x:Key="DemoChatBackgroundBrush" Color="#FFEDEFF3" />
                    <SolidColorBrush x:Key="DemoRowHoverBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="DemoMonoSurfaceBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="DemoMonoForegroundBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="DemoMonoBorderBrush" Color="#FF111111" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DemoPageBackgroundBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="DemoChatBackgroundBrush" Color="#FF1C1C1C" />
                    <SolidColorBrush x:Key="DemoRowHoverBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="DemoMonoSurfaceBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="DemoMonoForegroundBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="DemoMonoBorderBrush" Color="#FF3D3D3D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static infra:DemoTheme.Hacker}">
                    <SolidColorBrush x:Key="DemoPageBackgroundBrush" Color="#FF050807" />
                    <SolidColorBrush x:Key="DemoChatBackgroundBrush" Color="#FF0B120D" />
                    <SolidColorBrush x:Key="DemoRowHoverBrush" Color="#2200FF66" />
                    <SolidColorBrush x:Key="DemoMonoSurfaceBrush" Color="#FF0B120D" />
                    <SolidColorBrush x:Key="DemoMonoForegroundBrush" Color="#FFC9FFD8" />
                    <SolidColorBrush x:Key="DemoMonoBorderBrush" Color="#FF1F6F43" />

                    <SolidColorBrush x:Key="DialogixSurfaceBrush" Color="#FF0B120D" />
                    <SolidColorBrush x:Key="DialogixSurfaceForegroundBrush" Color="#FFC9FFD8" />
                    <SolidColorBrush x:Key="DialogixAccentBrush" Color="#FF103B25" />
                    <SolidColorBrush x:Key="DialogixAccentForegroundBrush" Color="#FFB7FFC9" />
                    <SolidColorBrush x:Key="DialogixBorderBrush" Color="#FF1F6F43" />
                    <SolidColorBrush x:Key="DialogixChatBackgroundBrush" Color="#FF050807" />
                    <SolidColorBrush x:Key="DialogixInputBackgroundBrush" Color="#FF0B120D" />
                    <SolidColorBrush x:Key="DialogixMutedForegroundBrush" Color="#FF6FCF97" />
                    <SolidColorBrush x:Key="DialogixPrimaryBrush" Color="#FF00C853" />
                    <SolidColorBrush x:Key="DialogixPrimaryHoverBrush" Color="#FF00E676" />
                    <SolidColorBrush x:Key="DialogixPrimaryPressedBrush" Color="#FF00A344" />
                    <SolidColorBrush x:Key="DialogixPrimaryForegroundBrush" Color="#FF001B0C" />
                    <SolidColorBrush x:Key="DialogixDangerBrush" Color="#FFFF5252" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme />
        <StyleInclude Source="avares://Dialogix.Avalonia/Themes/Generic.axaml" />
    </Application.Styles>

</Application>
