<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dialogix.Avalonia.Controls"
        xmlns:converters="using:Avalonia.Data.Converters">

    <Styles.Resources>

        <ControlTheme x:Key="DialogixProfileEditButtonTheme"
                      TargetType="Button">

            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource DialogixSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogixBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixInputBackgroundBrush}" />
            </Style>

        </ControlTheme>

        <ControlTheme x:Key="DialogixProfileItemTheme"
                      TargetType="ListBoxItem">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:focus /template/ Border#PART_Root">
                <Setter Property="BorderBrush" Value="{DynamicResource DialogixPrimaryBrush}" />
            </Style>

        </ControlTheme>

        <ControlTheme x:Key="{x:Type controls:ProfileView}"
                      TargetType="controls:ProfileView">

            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="PlaceholderIcon" Value="{DynamicResource DialogixUserIconGeometry}" />
            <Setter Property="EditIcon" Value="{DynamicResource DialogixPencilIconGeometry}" />

            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="18">

                        <Panel Width="112"
                               Height="112"
                               HorizontalAlignment="Center">

                            <Border Name="PART_Avatar"
                                    Width="112"
                                    Height="112"
                                    CornerRadius="56"
                                    ClipToBounds="True"
                                    Background="{DynamicResource DialogixChatBackgroundBrush}"
                                    BorderBrush="{DynamicResource DialogixBorderBrush}"
                                    BorderThickness="1">

                                <Panel>
                                    <controls:IconPresenter Name="PART_Placeholder"
                                                            Width="42"
                                                            Height="42"
                                                            Source="{TemplateBinding PlaceholderIcon}"
                                                            Fill="{DynamicResource DialogixMutedForegroundBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding Avatar,
                                              Converter={x:Static converters:ObjectConverters.IsNull}}" />

                                    <Image Name="PART_Image"
                                           Stretch="UniformToFill"
                                           Source="{TemplateBinding Avatar}"
                                           IsVisible="{TemplateBinding Avatar,
                                               Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
                                </Panel>
                            </Border>

                            <Button Name="PART_Edit"
                                    Theme="{StaticResource DialogixProfileEditButtonTheme}"
                                    Command="{TemplateBinding EditCommand}"
                                    IsVisible="{TemplateBinding IsEditVisible}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                                <controls:IconPresenter Width="13"
                                                        Height="13"
                                                        Source="{TemplateBinding EditIcon}"
                                                        Fill="{DynamicResource DialogixSurfaceForegroundBrush}" />
                            </Button>

                        </Panel>

                        <TextBlock Name="PART_Name"
                                   Text="{TemplateBinding DisplayName}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   IsVisible="{TemplateBinding DisplayName,
                                       Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />

                        <ListBox Name="PART_Items"
                                 ItemsSource="{TemplateBinding Items}"
                                 ItemTemplate="{TemplateBinding ItemTemplate}"
                                 SelectedItem="{Binding SelectedItem,
                                     RelativeSource={RelativeSource TemplatedParent},
                                     Mode=TwoWay}"
                                 ItemContainerTheme="{StaticResource DialogixProfileItemTheme}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FocusAdorner="{x:Null}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                    </StackPanel>
                </ControlTemplate>
            </Setter>

        </ControlTheme>

    </Styles.Resources>
</Styles>
