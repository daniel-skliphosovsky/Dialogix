<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dialogix.Avalonia.Controls"
        xmlns:converters="using:Avalonia.Data.Converters">

    <Styles.Resources>

        <ControlTheme x:Key="DialogixProfileSecondaryButtonTheme"
                      TargetType="Button">

            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource DialogixSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogixBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixInputBackgroundBrush}" />
            </Style>

        </ControlTheme>

        <ControlTheme x:Key="DialogixProfilePrimaryButtonTheme"
                      TargetType="Button">

            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource DialogixPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixPrimaryForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixPrimaryHoverBrush}" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixPrimaryPressedBrush}" />
            </Style>

        </ControlTheme>

        <ControlTheme x:Key="{x:Type controls:ProfileEditorView}"
                      TargetType="controls:ProfileEditorView">

            <Setter Property="Background" Value="{DynamicResource DialogixSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogixBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="PlaceholderIcon" Value="{DynamicResource DialogixUserIconGeometry}" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="0 10 36 -16 #40000000">

                        <StackPanel Spacing="16">

                            <TextBlock Name="PART_Title"
                                       Text="{TemplateBinding Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       IsVisible="{TemplateBinding Title,
                                           Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />

                            <Border Name="PART_Avatar"
                                    Width="88"
                                    Height="88"
                                    CornerRadius="44"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource DialogixChatBackgroundBrush}"
                                    BorderBrush="{DynamicResource DialogixBorderBrush}"
                                    BorderThickness="1">

                                <Panel>
                                    <Path Name="PART_Placeholder"
                                          Width="34"
                                          Height="34"
                                          Stretch="Uniform"
                                          Data="{TemplateBinding PlaceholderIcon}"
                                          Fill="{DynamicResource DialogixMutedForegroundBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding Avatar,
                                              Converter={x:Static converters:ObjectConverters.IsNull}}" />

                                    <Image Name="PART_Image"
                                           Stretch="UniformToFill"
                                           Source="{TemplateBinding Avatar}"
                                           IsVisible="{TemplateBinding Avatar,
                                               Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
                                </Panel>
                            </Border>

                            <ContentPresenter Name="PART_Fields"
                                              Content="{TemplateBinding Fields}"
                                              ContentTemplate="{TemplateBinding FieldsTemplate}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">

                                <Button Name="PART_Cancel"
                                        Theme="{StaticResource DialogixProfileSecondaryButtonTheme}"
                                        Content="{TemplateBinding CancelText}"
                                        Command="{TemplateBinding CancelCommand}" />

                                <Button Name="PART_Save"
                                        Theme="{StaticResource DialogixProfilePrimaryButtonTheme}"
                                        Content="{TemplateBinding SaveText}"
                                        Command="{TemplateBinding SaveCommand}" />

                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>

        </ControlTheme>

    </Styles.Resources>
</Styles>
