<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dialogix.Avalonia.Controls"
        xmlns:converters="using:Avalonia.Data.Converters">

    <Styles.Resources>

        <ControlTheme x:Key="DialogixScrollButtonTheme"
                      TargetType="Button">

            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource DialogixSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogixBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixInputBackgroundBrush}" />
            </Style>

        </ControlTheme>

        <ControlTheme x:Key="{x:Type controls:ChatView}"
                      TargetType="controls:ChatView">

            <Setter Property="Background" Value="{DynamicResource DialogixChatBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="ScrollToEndIcon" Value="{DynamicResource DialogixScrollDownIconGeometry}" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">

                        <Grid>

                            <ScrollViewer Name="PART_Scroll"
                                          Theme="{DynamicResource DialogixScrollViewerTheme}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="PART_Items"
                                              ItemsSource="{TemplateBinding Messages}"
                                              ItemTemplate="{TemplateBinding MessageTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <ContentPresenter Name="PART_Empty"
                                              Content="{TemplateBinding EmptyContent}"
                                              ContentTemplate="{TemplateBinding EmptyContentTemplate}"
                                              IsVisible="{TemplateBinding IsEmpty}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                            <Border Name="PART_LoadingMore"
                                    IsVisible="{TemplateBinding IsLoadingMore}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,10,0,0"
                                    Padding="12,7"
                                    CornerRadius="12"
                                    Background="{DynamicResource DialogixSurfaceBrush}"
                                    BorderBrush="{DynamicResource DialogixBorderBrush}"
                                    BorderThickness="1">
                                <Panel>
                                    <ProgressBar Name="PART_LoadingBar"
                                                 Width="64"
                                                 Height="4"
                                                 MinHeight="0"
                                                 IsIndeterminate="True"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource DialogixPrimaryBrush}"
                                                 IsVisible="{TemplateBinding LoadingContent,
                                                     Converter={x:Static converters:ObjectConverters.IsNull}}" />

                                    <ContentPresenter Name="PART_LoadingContent"
                                                      Content="{TemplateBinding LoadingContent}"
                                                      ContentTemplate="{TemplateBinding LoadingContentTemplate}"
                                                      IsVisible="{TemplateBinding LoadingContent,
                                                          Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
                                </Panel>
                            </Border>

                            <Button Name="PART_ScrollToEnd"
                                    Theme="{StaticResource DialogixScrollButtonTheme}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,6,6"
                                    IsVisible="False">
                                <controls:IconPresenter Width="18"
                                                        Height="18"
                                                        Source="{TemplateBinding ScrollToEndIcon}"
                                                        Stroke="{DynamicResource DialogixSurfaceForegroundBrush}"
                                                        StrokeThickness="2" />
                            </Button>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>

        </ControlTheme>

    </Styles.Resources>

</Styles>
