<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Dialogix.Avalonia.Controls"
        xmlns:converters="using:Avalonia.Data.Converters">

    <Styles.Resources>

        <ControlTheme x:Key="DialogixSendButtonTheme"
                      TargetType="Button">

            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource DialogixPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixPrimaryForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixPrimaryHoverBrush}" />
            </Style>

            <Style Selector="^:pressed /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource DialogixPrimaryPressedBrush}" />
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
            </Style>

        </ControlTheme>

        <ControlTheme x:Key="{x:Type controls:MessageInput}"
                      TargetType="controls:MessageInput">

            <Setter Property="Background" Value="{DynamicResource DialogixInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DialogixSurfaceForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DialogixBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="SendIcon" Value="{DynamicResource DialogixSendIconGeometry}" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">

                            <ContentPresenter Name="PART_Leading"
                                              Content="{TemplateBinding LeadingContent}"
                                              ContentTemplate="{TemplateBinding LeadingContentTemplate}"
                                              IsVisible="{TemplateBinding LeadingContent,
                                                  Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                              VerticalAlignment="Center" />

                            <TextBox Name="PART_TextBox"
                                     Grid.Column="1"
                                     AutomationProperties.Name="{TemplateBinding Watermark}"
                                     Theme="{DynamicResource DialogixTextBoxTheme}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                     PlaceholderText="{TemplateBinding Watermark}"
                                     PlaceholderForeground="{DynamicResource DialogixMutedForegroundBrush}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.AllowAutoHide="False"
                                     MinLines="1"
                                     MaxLines="{TemplateBinding MaxLines}"
                                     MinHeight="36"
                                     Padding="10,8"
                                     FontSize="14"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{TemplateBinding Foreground}" />

                            <TextBlock Name="PART_Counter"
                                       Grid.Column="2"
                                       IsVisible="False"
                                       Margin="0,0,2,0"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DialogixMutedForegroundBrush}" />

                            <ContentPresenter Name="PART_Action"
                                              Grid.Column="3"
                                              Content="{TemplateBinding ActionContent}"
                                              ContentTemplate="{TemplateBinding ActionContentTemplate}"
                                              IsVisible="{TemplateBinding ActionContent,
                                                  Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                              VerticalAlignment="Center" />

                            <Button Name="PART_SendButton"
                                    Grid.Column="4"
                                    AutomationProperties.Name="Send message"
                                    Theme="{StaticResource DialogixSendButtonTheme}"
                                    VerticalAlignment="Bottom"
                                    IsEnabled="{TemplateBinding CanSend}">
                                <controls:IconPresenter Width="18"
                                                        Height="18"
                                                        Source="{TemplateBinding SendIcon}"
                                                        Stroke="{DynamicResource DialogixPrimaryForegroundBrush}"
                                                        StrokeThickness="2" />
                            </Button>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:focused /template/ Border#PART_Frame">
                <Setter Property="BorderBrush" Value="{DynamicResource DialogixPrimaryBrush}" />
            </Style>

            <Style Selector="^:toolong /template/ TextBlock#PART_Counter">
                <Setter Property="Foreground" Value="{DynamicResource DialogixDangerBrush}" />
            </Style>

            <Style Selector="^:toolong /template/ Border#PART_Frame">
                <Setter Property="BorderBrush" Value="{DynamicResource DialogixDangerBrush}" />
            </Style>

        </ControlTheme>

    </Styles.Resources>

</Styles>
