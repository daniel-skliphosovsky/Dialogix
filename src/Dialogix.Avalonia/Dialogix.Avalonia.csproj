<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <PackageId>Dialogix.Avalonia</PackageId>
        <Version>0.1.0-alpha</Version>
        <Description>Chat controls for Avalonia. Build messenger interfaces without rebuilding the same bubbles.</Description>
        <PackageTags>avalonia;chat;messenger;ui;controls</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <Authors>daniel-skliphosovsky</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <RepositoryUrl>https://github.com/daniel-skliphosovsky/Dialogix</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
